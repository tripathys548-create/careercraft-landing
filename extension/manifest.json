{
  "manifest_version": 3,
  "name": "CareerCraft",
  "version": "1.0.0",
  "description": "AI-powered LinkedIn profile rewrite, referral DM generator, and free resume PDF.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://www.linkedin.com/*"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/in/*"],
      "js": ["src/content/scraper.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "CareerCraft"
  }
}
